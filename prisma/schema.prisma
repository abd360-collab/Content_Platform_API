
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum MediaType {
  SHOW_COVER
  EPISODE_AUDIO
}

enum MediaUploadStatus {
  PENDING
  VERIFYING
  VERIFIED
  REJECTED
  ATTACHED
  EXPIRED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  follows           Follow[]
  sessions          Session[]
  listeningProgress ListeningProgress[]
  mediaUploads      MediaUpload[]
}

model Session {
  id                String    @id @default(uuid())
  userId            String
  familyId          String
  refreshTokenHash  String
  expiresAt         DateTime
  revokedAt         DateTime?
  revokedReason     String?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model Show {
  id            String   @id @default(uuid())
  title         String
  description   String
  coverImageUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  episodes   Episode[]
  follows    Follow[]
  categories ShowCategory[]
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shows ShowCategory[]
}

model ShowCategory {
  showId     String
  categoryId String
  createdAt  DateTime @default(now())

  show     Show     @relation(fields: [showId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([showId, categoryId])
  @@index([categoryId])
}

model Episode {
  id                String   @id @default(uuid())
  showId            String
  title             String
  description       String
  audioUrl          String
  durationInSeconds Int
  episodeNumber     Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  listeningProgress ListeningProgress[]

  show Show @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@unique([showId, episodeNumber])
  @@index([showId])
}

model Follow {
  userId    String
  showId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  show Show @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@id([userId, showId])
  @@index([showId])
}

model ListeningProgress {
  userId            String
  episodeId         String
  positionInSeconds Int
  updatedAt         DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@id([userId, episodeId])
  @@index([episodeId])
}

model MediaUpload {
  id           String            @id @default(uuid())
  userId       String
  mediaType    MediaType
  publicId     String            @unique
  resourceType String
  status       MediaUploadStatus @default(PENDING)

  secureUrl    String?
  format       String?
  bytes        Int?

  expiresAt    DateTime
  verifiedAt   DateTime?
  attachedAt   DateTime?

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([expiresAt])
}
